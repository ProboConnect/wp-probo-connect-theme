{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "probo/portal-hero",
	"title": "Portaalbanner",
	"category": "probo",
	"icon": "admin-home",
	"description": "De donkere welkomstband boven het bestelportaal, met de naam van de ingelogde klant.",
	"textdomain": "probo-connect-theme",
	"supports": { "className": false, "html": false, "align": ["full"], "anchor": true },
	"attributes": {
		"eyebrow": { "type": "string", "default": "Bestelportaal" },
		"title": { "type": "string", "default": "Welkom terug, {name}" },
		"placeholderName": { "type": "string", "default": "[Bedrijfsnaam]" },
		"imageId": { "type": "number", "default": 0 }
	},
	"editorScript": "file:./index.js",
	"render": "file:./render.php"
}
